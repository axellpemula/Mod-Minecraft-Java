{
	"schemaVersion": 1,
	"id": "wheel_of_adaptation",
	"version": "${version}",
	"name": "Wheel of Adaptation",
	"description": "Mod tentang roda adaptasi — putar roda, terima adaptasi, bertahan hidup dengan cara baru!",
	"authors": [
		"axellpemula"
	],
	"contact": {
		"homepage": "https://github.com/axellpemula/Mod-Minecraft-Java",
		"sources": "https://github.com/axellpemula/Mod-Minecraft-Java"
	},
	"license": "CC0-1.0",
	"icon": "assets/wheel_of_adaptation/icon.png",
	"environment": "*",
	"entrypoints": {
		"main": [
			"com.wheelofadaptation.WheelOfAdaptationMod"
		],
		"client": [
			"com.wheelofadaptation.client.WheelOfAdaptationClient"
		]
	},
	"mixins": [
		"wheel_of_adaptation.mixins.json",
		{
			"config": "wheel_of_adaptation.client.mixins.json",
			"environment": "client"
		}
	],
	"depends": {
		"fabricloader": ">=0.20.1",
		"minecraft": "~1.21.1",
		"java": ">=21",
		"fabric-api": "*"
	}
}
